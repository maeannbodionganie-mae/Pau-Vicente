# Copy these names into Vercel → Project → Settings → Environment Variables.
# Placeholders only. Never commit real values.

# Inquiry form → private Google Apps Script web app (see INQUIRY_SETUP.md)
INQUIRY_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
INQUIRY_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# Optional: Pau assistant live AI (see PAU_ASSISTANT.md)
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional: web lookup for questions outside the portfolio, via Google Programmable Search
# (Custom Search JSON API key + search engine ID, set to search the entire web).
# Without these, the assistant tries Gemini's built-in Google Search grounding instead.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Graphify uses a bundled export built by scripts/build-pau-graph.py.
# No Graphify Cloud credentials are required for this deployment.
